# Project artifacts: data/* is ignored, but keep both .gitkeep markers and the
# pakistan/ subdir itself so the layout survives a fresh clone.
data/*
!data/.gitkeep
!data/pakistan/
data/pakistan/*
!data/pakistan/.gitkeep

# Benchmark output — keep canonical results.json, tck/snb results + .gitkeep, ignore the rest.
benchmark/results/*
!benchmark/results/.gitkeep
!benchmark/results/results.json
!benchmark/results/tck_compatibility_results.json
!benchmark/results/snb_interactive_results.json
!benchmark/results/cypherbench_engine_parity.json
!benchmark/results/cypherbench_engine_parity_failures.json
!benchmark/results/cypherbench_engine_parity_timeouts.json
!benchmark/results/nl_failure_taxonomy.json
!benchmark/results/nl_benchmark_manifest.json
!benchmark/results/perf/
!benchmark/results/cypherbench_nl2cypher__*.json
!benchmark/results/metaqa_nl2cypher__*.json
!benchmark/results/gemini_nl_benchmark_answers.xlsx
benchmark/cache/


# SQLite mirror
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Test/coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Virtualenvs
.venv/
venv/
env/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Temporary scratch scripts
scratch/

benchmark/data/*.tsv
benchmark/data/*.sif.gz
benchmark/data/*.csv

