// GQL-Core: Full openCypher & ISO GQL multi-clause grammar
start: query ( UNION_KW ALL_KW? query )*                 -> union_query

query: clause+                                           -> clause_query

clause: optional_match_clause
      | match_clause
      | unwind_clause
      | with_clause
      | create_clause
      | set_clause
      | delete_clause
      | remove_clause
      | merge_clause
      | call_subquery
      | call_clause
      | return_clause

optional_match_clause: "OPTIONAL"i "MATCH"i pattern ("," pattern)* where_clause?
match_clause: "MATCH"i pattern ("," pattern)* where_clause?
unwind_clause: "UNWIND"i expr "AS"i ident
with_clause: "WITH"i DISTINCT? (return_item ("," return_item)* | STAR) where_clause? order_by? skip? limit?
return_clause: "RETURN"i DISTINCT? (return_item ("," return_item)* | STAR) order_by? skip? limit?

call_subquery: "CALL"i "{" start "}"
call_clause: "CALL"i proc_name ("(" (expr ("," expr)*)? ")")? ("YIELD"i yield_item ("," yield_item)*)?
proc_name: ident ("." ident)*
yield_item: STAR | ident ("AS"i ident)?

create_clause: "CREATE"i pattern ("," pattern)*
set_clause: "SET"i set_item ("," set_item)*
delete_clause: DETACH? "DELETE"i expr ("," expr)*
remove_clause: "REMOVE"i remove_item ("," remove_item)*
merge_clause: "MERGE"i pattern merge_action*

merge_action: "ON"i "CREATE"i "SET"i set_item ("," set_item)* -> merge_on_create
            | "ON"i "MATCH"i "SET"i set_item ("," set_item)*  -> merge_on_match

set_item: postfix_expr "=" expr                          -> set_prop
        | postfix_expr "+=" expr                         -> set_prop_merge
        | postfix_expr ":" label_name (":" label_name)*  -> set_labels

remove_item: ident ":" label_name (":" label_name)*          -> remove_labels
           | postfix_expr DOT ident                          -> remove_prop

pattern: (ident "=")? node_pat (rel_pat node_pat)*
node_pat: "(" ident? (":" label_name)* map_lit? ")"

rel_pat: "-[" edge_var? edge_label? quantifier? map_lit? "]->"   -> rel_out
       | "<-[" edge_var? edge_label? quantifier? map_lit? "]-"   -> rel_in
       | "<-[" edge_var? edge_label? quantifier? map_lit? "]->"  -> rel_undirected
       | "-[" edge_var? edge_label? quantifier? map_lit? "]-"    -> rel_undirected
       | "-->"                                                    -> rel_out_anon
       | "<--"                                                    -> rel_in_anon
       | "<-->"                                                   -> rel_undirected_anon
       | "--"                                                     -> rel_undirected_anon

edge_var: ident
edge_label: ":" label_name ("|" ":"? label_name)*

quantifier: "*"                                          -> q_star
          | "+"                                          -> q_plus
          | "*" INT                                      -> q_exactly
          | "*" INT DOTDOT INT                           -> q_range
          | "*" DOTDOT INT                               -> q_range_to
          | "*" INT DOTDOT                               -> q_range_from
          | "*" DOTDOT                                   -> q_star

where_clause: "WHERE"i expr

pattern_predicate: node_pat (rel_pat node_pat)+

return_item: expr alias?                                 -> proj_item
alias: "AS"i ident

order_by: "ORDER"i "BY"i order_term ("," order_term)*
order_term: expr direction?
direction: ASC | DESC
skip: "SKIP"i expr
limit: "LIMIT"i expr

?expr: or_expr

?or_expr: xor_expr
        | or_expr "OR"i xor_expr                          -> or_op

?xor_expr: and_expr
         | xor_expr "XOR"i and_expr                       -> xor_op

?and_expr: not_expr
         | and_expr "AND"i not_expr                       -> and_op

?not_expr: NOT_KW not_expr                               -> not_op
         | comp_expr

?comp_expr: predicate_expr
          | comp_expr "=" predicate_expr                 -> eq_op
          | comp_expr "<>" predicate_expr                -> neq_op
          | comp_expr "!=" predicate_expr                -> neq_op
          | comp_expr "<" predicate_expr                 -> lt_op
          | comp_expr "<=" predicate_expr                -> lte_op
          | comp_expr ">" predicate_expr                 -> gt_op
          | comp_expr ">=" predicate_expr                -> gte_op

?predicate_expr: add_expr
               | predicate_expr IS_KW NULL_KW            -> is_null_op
               | predicate_expr IS_KW NOT_KW NULL_KW      -> is_not_null_op
               | predicate_expr "STARTS"i "WITH"i add_expr -> starts_with_op
               | predicate_expr "ENDS"i "WITH"i add_expr   -> ends_with_op
               | predicate_expr "CONTAINS"i add_expr      -> contains_op
               | predicate_expr "=~" add_expr            -> regex_op
               | predicate_expr "IN"i add_expr            -> in_op

?add_expr: mul_expr
         | add_expr "+" mul_expr                         -> add_op
         | add_expr "-" mul_expr                         -> sub_op

?mul_expr: power_expr
         | mul_expr "*" power_expr                       -> mul_op
         | mul_expr "/" power_expr                       -> div_op
         | mul_expr "%" power_expr                       -> mod_op

?power_expr: unary_expr
           | power_expr "^" unary_expr                   -> pow_op

?unary_expr: "-" unary_expr                              -> neg_op
           | "+" unary_expr                              -> pos_op
           | postfix_expr

?postfix_expr: atom
             | postfix_expr "[" expr "]"                 -> index_op
             | postfix_expr "[" expr? DOTDOT expr? "]"   -> slice_op
             | postfix_expr DOT ident                    -> prop_op
             | postfix_expr ":" label_name               -> label_check_op
             | postfix_expr "(" DISTINCT? (expr ("," expr)* | STAR)? ")" -> postfix_call

?atom: value
     | quantifier_call
     | exists_subquery
     | param
     | case_expr
     | list_comprehension
     | pattern_comprehension
     | pattern_predicate
     | ident                                             -> var_ref
     | list_lit
     | map_lit
     | "(" expr ")"                                      -> paren_expr

exists_subquery: EXISTS_KW "{" (pattern where_clause? | start) "}"
quantifier_call: QUANTIFIER_FUNC "(" ident "IN"i expr ("WHERE"i expr)? ")"

param: "$" (ident | INT)

case_expr: "CASE"i expr? (when_then)+ ("ELSE"i expr)? "END"i
when_then: "WHEN"i expr "THEN"i expr

list_comprehension: "[" ident "IN"i expr list_comp_where? list_comp_map? "]"
list_comp_where: "WHERE"i expr
list_comp_map: "|" expr
pattern_comprehension: "[" (ident "=")? pattern_expr ("WHERE"i expr)? "|" expr "]"
pattern_expr: node_pat (rel_pat node_pat)+

list_lit: "[" (expr ("," expr)*)? "]"
map_lit: "{" (map_entry ("," map_entry)*)? "}"
map_entry: (ident | ESCAPED_STRING) ":" expr

COMMENT: /\/\/.*|\/\*(.|\n)*?\*\//
%ignore COMMENT

ident: CNAME | ESCAPED_IDENT
label_name: LABEL | ESCAPED_IDENT

value: HEX_INT                                           -> hex_val
     | OCT_INT                                           -> oct_val
     | ESCAPED_STRING                                    -> str_val
     | SINGLE_QUOTED_STRING                              -> single_str_val
     | SIGNED_NUMBER                                     -> num_val
     | TRUE                                              -> true_val
     | FALSE                                             -> false_val
     | NULL                                              -> null_val

TRUE: "true" | "TRUE"i
FALSE: "false" | "FALSE"i
NULL: "null" | "NULL"i
STAR: "*"
SINGLE_QUOTED_STRING: /'([^'\\]|\\.)*'/
HEX_INT.2: /-?0[xX][0-9a-fA-F]+/
OCT_INT.2: /-?0[oO][0-7]+/

ASC.2: /(?i:ASC(?:ENDING)?)/
DESC.2: /(?i:DESC(?:ENDING)?)/
DISTINCT.2: /(?i:DISTINCT)/
UNION_KW.2: /(?i:UNION)/
ALL_KW.2: /(?i:ALL)/
DETACH.2: /(?i:DETACH)/
EXISTS_KW.2: /(?i:EXISTS)/
QUANTIFIER_FUNC.3: /(?i:ALL|ANY|NONE|SINGLE)(?=\s*\()/

DOTDOT.10: ".."
DOT.1: "."
LABEL: /[a-zA-Z_][a-zA-Z_0-9]*/
ESCAPED_IDENT: /`[^`]+`/

IS_KW.2: /(?i:IS)/
NULL_KW.2: /(?i:NULL)/
NOT_KW.2: /(?i:NOT)/
OPTIONAL_KW.2: /(?i:OPTIONAL)/

FLOAT_NUMBER.2: /-?(?:[0-9]+\.[0-9]+|\.[0-9]+)(?:[eE][+-]?[0-9]+)?|-?[0-9]+[eE][+-]?[0-9]+/
INT_NUMBER: /-?[0-9]+/
SIGNED_NUMBER: FLOAT_NUMBER | INT_NUMBER

%import common.CNAME
%import common.INT
%import common.ESCAPED_STRING
%import common.WS
%ignore WS
